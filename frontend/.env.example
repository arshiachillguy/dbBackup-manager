# Backend base URL used by the frontend API client (src/api/client.ts).
#
# Leave empty to use the Vite dev proxy, which forwards /api requests to
# http://localhost:8080 and avoids CORS during local development (recommended).
VITE_API_BASE_URL=

# Connecting directly to the backend (requires CORS to be configured on the
# Spring Boot backend for the frontend origin):
# VITE_API_BASE_URL=http://localhost:8080
